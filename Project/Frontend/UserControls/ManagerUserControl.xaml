<UserControl x:Class="SportsCenter.Frontend.UserControls.ManagerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Công cụ Tìm kiếm & Lọc -->
        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,10,0" Padding="5" TextChanged="txtSearch_TextChanged" />
            <ComboBox x:Name="cmbRoleFilter" Width="120" Margin="0,0,10,0" SelectionChanged="cmbRoleFilter_SelectionChanged">
                <ComboBoxItem Content="Mọi vai trò" IsSelected="True" />
                <!-- Thêm Tag tương ứng với Enum của nhóm em -->
                <ComboBoxItem Content="Quản lý" Tag="Manager"/>
                <ComboBoxItem Content="Huấn luyện viên" Tag="Coach"/>
                <ComboBoxItem Content="Thành viên" Tag="Member"/>
                <ComboBoxItem Content="Lễ tân" Tag="Receptionist"/>
            </ComboBox>
            <!-- Thêm vào UserDetailWindow.xaml -->
            <TextBlock Text="Vai trò:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbRole" Margin="0,0,0,15" Padding="5">
                <ComboBoxItem Content="Quản lý" Tag="Manager"/>
                <ComboBoxItem Content="Huấn luyện viên" Tag="Coach"/>
                <ComboBoxItem Content="Thành viên" Tag="Member"/>
                <ComboBoxItem Content="Lễ tân" Tag="Receptionist"/>
            </ComboBox>

        </StackPanel>

        <!-- Các nút thao tác -->
        <StackPanel Orientation="Horizontal" Grid.Column="1">
            <Button Content="+ Tạo tài khoản" Click="btnAddUser_Click" Width="100" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Sửa" Click="btnUpdateUser_Click" Width="70" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Xóa" Click="btnDeleteUser_Click" Width="70" Padding="5"/>
        </StackPanel>
        <DataGrid AutoGenerateColumns="True" Grid.Row="1" IsReadOnly="True" SelectionChanged="dgUsers_SelectionChanged" x:Name="dgUsers"/>

        
    </Grid>
    
</UserControl>

