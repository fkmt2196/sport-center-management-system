<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Bảng màu và font dùng chung cho toàn ứng dụng (tương đương biến CSS).
        Đổi màu ở đây là toàn bộ giao diện đổi theo.
    -->

    <!-- Màu chủ đạo: xanh dương -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="PrimarySoft2Brush" Color="#DBEAFE"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#64748B"/>

    <!-- Nền, bề mặt, đường viền -->
    <SolidColorBrush x:Key="BgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BackdropBrush" Color="#990F172A"/>

    <!-- Chữ -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- Trạng thái -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#CFFAFE"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="VioletSoftBrush" Color="#EDE9FE"/>

    <!-- Font: Segoe UI có sẵn trên Windows, hiển thị đầy đủ dấu tiếng Việt -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
</ResourceDictionary>
