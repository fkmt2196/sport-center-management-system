<UserControl x:Class="SportCenter.Wpf.Views.Members.ClassCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="296" Margin="0,0,16,16">
    <Border Style="{StaticResource SurfaceStyle}" Padding="20">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Session.Sport}" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" Padding="8,4" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableSlots}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
            <TextBlock Text="{Binding Session.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="52" />
            <TextBlock Text="{Binding DayLabel}" Margin="0,10,0,4" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{Binding TimeLabel}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Session.Coach.FullName, StringFormat=HLV: {0}}" Margin="0,12,0,4"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{Binding Session.Room.Name, StringFormat=Phòng: {0}}" Style="{StaticResource MutedTextStyle}" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding CapacityLabel}" FontSize="12" Margin="0,0,0,10" />
                    <Button Content="Xem chi tiết" HorizontalContentAlignment="Center"
                            Command="{Binding DataContext.ShowClassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
