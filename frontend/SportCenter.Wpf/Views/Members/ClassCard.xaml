<UserControl x:Class="SportCenter.Wpf.Views.Members.ClassCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,6">
    <Border Style="{DynamicResource TrackScheduleRow}">
        <Grid MinHeight="76">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="202" />
                <ColumnDefinition Width="158" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource TrackRaised}" BorderBrush="{DynamicResource TrackLine}" BorderThickness="0,0,1,0" Padding="12,8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DayLabel}" Style="{DynamicResource TrackLabel}" />
                    <TextBlock Text="{Binding TimeLabel}" FontFamily="{DynamicResource TrackMono}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,10,8">
                <TextBlock Text="{Binding Session.Sport}" Style="{DynamicResource TrackLabel}" Foreground="{DynamicResource TrackLime}" />
                <TextBlock Text="{Binding Session.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Session.Coach.FullName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Session.Room.Name}" Style="{DynamicResource TrackMutedText}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="12,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TrackLime}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableSlots}" Value="0">
                                    <Setter Property="Foreground" Value="{DynamicResource TrackAmber}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TrackMuted}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding CapacityLabel}" Style="{DynamicResource TrackMutedText}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="4" Content="Xem chi tiết" Style="{DynamicResource TrackButton}" Margin="6,8,12,8" VerticalAlignment="Center"
                    Command="{Binding DataContext.ShowClassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </Border>
</UserControl>
