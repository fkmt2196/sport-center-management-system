<UserControl x:Class="SportCenter.Wpf.Views.Members.MemberDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:members="clr-namespace:SportCenter.Wpf.Views.Members"
             x:Name="DashboardRoot" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,30">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="12,0,0,36">
                    <TextBlock Text="SPORT / CENTER" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="KHÔNG GIAN HỌC VIÊN" FontSize="10" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Mỗi buổi tập là một bước tiến." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Duy trì đều đặn, tiến bộ mỗi ngày." Margin="0,8,0,0" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MemberCode}" Margin="0,5,0,0" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel>
                    <Button Content="Lịch học" Style="{StaticResource NavigationButtonStyle}" Tag="{Binding IsScheduleTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="schedule" />
                    <Button Content="Lịch sử tập luyện" Style="{StaticResource NavigationButtonStyle}" Tag="{Binding IsHistoryTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="history" />
                    <Button Content="Tiến độ của bạn" Style="{StaticResource NavigationButtonStyle}" Tag="{Binding IsProgressTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="progress" />
                    <Button Content="Gói tập &amp; hồ sơ" Style="{StaticResource NavigationButtonStyle}" Tag="{Binding IsProfileTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="profile" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="32,26,24,20">
            <Grid DockPanel.Dock="Top" Margin="0,0,8,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TodayLabel}" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding Greeting}" FontSize="23" FontWeight="SemiBold" Margin="0,8,12,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource WarningLightBrush}" Padding="12,7" CornerRadius="6"
                        VerticalAlignment="Top" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DỮ LIỆU MẪU" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
            <StackPanel DockPanel.Dock="Top">
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,8,12"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Border Background="{StaticResource DangerLightBrush}" Padding="16" CornerRadius="8" Margin="0,0,8,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Thử lại" Command="{Binding RefreshCommand}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,20">
                        <Border Style="{StaticResource SurfaceStyle}" Padding="18" Width="174" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="Lớp đã đặt / tuần" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <TextBlock Text="{Binding RegisteredCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="18" Width="174" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="Buổi đã tham gia" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <TextBlock Text="{Binding AttendedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="18" Width="174" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="Tỷ lệ có mặt" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <TextBlock Text="{Binding AttendanceRateLabel}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="18" Width="174" Margin="0,0,12,12">
                            <StackPanel><TextBlock Text="Lượt tập còn lại" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <TextBlock Text="{Binding RemainingSessions}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{StaticResource PrimaryBrush}" /></StackPanel>
                        </Border>
                    </WrapPanel>
                    <DockPanel Margin="0,0,8,20">
                        <Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshCommand}" />
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Schedule: reusable nested class cards; registration data belongs to the booking module. -->
                    <StackPanel Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SurfaceStyle}" Padding="18" Margin="0,0,8,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="‹" ToolTip="Tuần trước" AutomationProperties.Name="Tuần trước"
                                                Command="{Binding PreviousWeekCommand}" Margin="6,0,0,0" />
                                        <Button Content="Tuần này" Command="{Binding CurrentWeekCommand}" Margin="6,0,0,0" />
                                        <Button Content="›" ToolTip="Tuần sau" AutomationProperties.Name="Tuần sau"
                                                Command="{Binding NextWeekCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Tìm lớp, HLV hoặc phòng" FontSize="12" Margin="0,0,0,6" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm lớp học" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bộ môn" FontSize="12" Margin="0,0,0,6" Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Sports}" SelectedItem="{Binding SelectedSport}" AutomationProperties.Name="Lọc bộ môn" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ClassCountLabel}" FontSize="12" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                    <CheckBox Content="Chỉ hiện lớp đã đăng ký" IsChecked="{Binding RegisteredOnly}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Classes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><members:ClassCard /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,8,16"
                                Visibility="{Binding IsScheduleEmpty, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Chưa có lớp phù hợp" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Thử đổi tuần hoặc bỏ bớt điều kiện tìm kiếm." Margin="0,8,0,16" Style="{StaticResource MutedTextStyle}" />
                                <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0">
                        <Border Style="{StaticResource SurfaceStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,20">
                                    <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding AttendanceFilters}"
                                              SelectedItem="{Binding AttendanceFilter}" AutomationProperties.Name="Lọc điểm danh" />
                                    <StackPanel>
                                        <TextBlock Text="Nhìn lại hành trình của bạn" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TrainingHoursLabel, StringFormat=Tổng thời gian có mặt: {0} giờ}"
                                                   Margin="0,6,12,0" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="AttendanceGrid" ItemsSource="{Binding Attendance}" MaxHeight="480" MinHeight="100" SelectedIndex="0"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày &amp; giờ" Binding="{Binding DateLabel}" Width="1.3*" MinWidth="148" />
                                        <DataGridTextColumn Header="Lớp học" Binding="{Binding Record.ClassName}" Width="1.5*" MinWidth="165" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="Huấn luyện viên" Binding="{Binding Record.CoachName}" Width="1.4*" MinWidth="153" ElementStyle="{StaticResource GridCellTextStyle}" />
                                        <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationLabel}" Width="90" />
                                        <DataGridTextColumn Header="Điểm danh" Binding="{Binding StatusLabel}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Chưa có lịch sử phù hợp với bộ lọc." Margin="0,16,0,0" Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding IsAttendanceEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <Border Background="{StaticResource BackgroundBrush}" Padding="16" CornerRadius="8" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Nhận xét của huấn luyện viên" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedItem.Record.CoachComment, ElementName=AttendanceGrid, TargetNullValue=Chọn một buổi tập để xem nhận xét.}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Tỷ lệ có mặt được tính trên các buổi có mặt và vắng mặt; không tính buổi nghỉ có phép."
                                           FontSize="12" Margin="0,16,0,0" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsProgressTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Các chỉ số gần nhất và mục tiêu do huấn luyện viên ghi nhận."
                                   Margin="0,0,8,20" Style="{StaticResource MutedTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Progress}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SurfaceStyle}" Width="296" Margin="0,0,16,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Record.MetricName}" FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentLabel}" FontSize="32" FontWeight="SemiBold" Margin="0,16,0,8" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding GoalLabel}" Style="{StaticResource MutedTextStyle}" />
                                            <ProgressBar Value="{Binding CompletionPercent, Mode=OneWay}" Margin="0,20,0,8" />
                                            <TextBlock Text="{Binding PercentLabel}" FontSize="12" />
                                            <TextBlock Text="{Binding BaselineLabel}" FontSize="12" Margin="0,12,0,6" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding UpdatedLabel}" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding Record.CoachComment}" Margin="0,18,0,0" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,8,0"
                                Visibility="{Binding IsProgressEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Chưa có đánh giá tiến độ. Chỉ số sẽ xuất hiện khi Coach cập nhật kết quả tập luyện."
                                       Style="{StaticResource MutedTextStyle}" />
                        </Border>
                    </StackPanel>

                    <Grid Visibility="{Binding IsProfileTab, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,16,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="GÓI TẬP HIỆN TẠI" FontSize="11" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding PlanName}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,14" TextWrapping="Wrap" />
                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding MembershipStatus}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding MembershipDescription}" Margin="0,20,0,18" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding MembershipUsageLabel}" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding MembershipUsagePercent, Mode=OneWay}" Margin="0,12,0,20" />
                                <TextBlock Text="{Binding MembershipPeriod}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MembershipExpiryLabel}" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="Liên hệ quầy tiếp tân để được hỗ trợ gia hạn hoặc đổi gói tập."
                                           Margin="0,24,0,0" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SurfaceStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Thông tin học viên" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,24" />
                                <TextBlock Text="Họ và tên" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding MemberName}" Margin="0,6,0,18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Mã học viên" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding MemberCode}" Margin="0,6,0,18" />
                                <TextBlock Text="Email" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding Email}" Margin="0,6,0,18" TextWrapping="Wrap" />
                                <TextBlock Text="Số điện thoại" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding Phone}" Margin="0,6,0,18" />
                                <TextBlock Text="Ngày tham gia" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding JoinedLabel}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.ColumnSpan="2" Background="#660D241C" Padding="80,40"
                Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource SurfaceStyle}" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="32">
                <StackPanel>
                    <TextBlock Text="CHI TIẾT BUỔI TẬP" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedClass.Session.Name}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,18" />
                    <TextBlock Text="{Binding SelectedClass.DayLabel}" FontSize="17" />
                    <TextBlock Text="{Binding SelectedClass.TimeLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,20" />
                    <TextBlock Text="{Binding SelectedClass.Session.Coach.FullName, StringFormat=Huấn luyện viên: {0}}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedClass.Session.Room.Name, StringFormat=Phòng tập: {0}}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedClass.CapacityLabel}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedClass.StatusLabel}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Đăng ký và hủy chỗ sẽ được kết nối với chức năng đặt lịch khi trung tâm mở đăng ký trực tuyến."
                               Margin="0,24,0,24" Style="{StaticResource MutedTextStyle}" />
                    <Button Content="Đóng" Command="{Binding CloseClassCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
