<Project Sdk="Microsoft.NET.Sdk">

  <!-- TẦNG 3 – DATA ACCESS LAYER (DAL)
       Entity (Models), DbContext, Migrations, dữ liệu mẫu.
       Không tham chiếu BLL hay giao diện. DbContext/DbConfig/DbSeeder là internal:
       chỉ BLL (InternalsVisibleTo) được truy cập CSDL. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SportsCenter.DAL</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SportsCenter.BLL" />
    <InternalsVisibleTo Include="Project.ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
